{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omacom.elsewhen",
          "zones": "Oslo|Europe/Oslo, Delhi|Asia/Kolkata, Tokyo|Asia/Tokyo, Los Angeles|America/Los_Angeles, New York|America/New_York"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.clock",
          "format": "yyyy-MM-dd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "weekStartDay": "monday",
          "birthYear": 0,
          "lifeExpectancy": 100
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "jankeesvw.downloads"
        },
        {
          "id": "io.github.elevate08.qs-bitwarden-cli",
          "autoLockMinutes": 60,
          "clearClipboardSec": 300,
          "pinUnlock": true
        },
        {
          "id": "kristianholme.ntfy"
        },
        {
          "id": "robzolkos.github"
        },
        {
          "id": "akitaonrails.ai-usagebar",
          "lastSelectedEntryId": "cursor"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "jankeesvw.notification-center"
        }
      ]
    }
  },
  "plugins": []
}
