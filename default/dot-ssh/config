Host *
    ServerAliveInterval 60
    ServerAliveCountMax 1440
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host saga betzy olivia
    User kholme
    Hostname %h.sigma2.no
    ForwardAgent yes
    setEnv TERM=xterm-256color
    ControlMaster auto
    ControlPath ~/.ssh/%r@%h:%p
    ControlPersist 4h

# herdr saved machines: pinned login node (home is shared across round-robin
# nodes, so the herdr server must always live on one). Reuses the 2FA master above.
# Never prompt: herdr reconnects in the background, and a ProxyJump hop would
# ask for 2FA on herdr's own terminal. Without a master these fail fast and
# herdr marks the machine; log in with dotfiles-ssh-login.sh (herdr: prefix+shift+l).
# The uio-jump aliases come before `Host nam-shub*` / `ml*` so their settings win.
Host saga-herdr
    Hostname login-4
    User kholme
    BatchMode yes
    ProxyCommand ssh -o BatchMode=yes -W %h:%p saga

Host olivia-herdr
    Hostname uan02
    User kholme
    BatchMode yes
    ProxyCommand ssh -o BatchMode=yes -W %h:%p olivia

Host nam-shub-01-herdr
    Hostname nam-shub-01
    User kholme
    BatchMode yes
    ProxyCommand ssh -o BatchMode=yes -W %h:%p uio

Host nam-shub-02-herdr
    Hostname nam-shub-02
    User kholme
    BatchMode yes
    ProxyCommand ssh -o BatchMode=yes -W %h:%p uio

Host ml6-herdr
    Hostname ml6.hpc.uio.no
    User kholme
    BatchMode yes
    ProxyCommand ssh -o BatchMode=yes -W %h:%p uio

Host ml7-herdr
    Hostname ml7.hpc.uio.no
    User kholme
    BatchMode yes
    ProxyCommand ssh -o BatchMode=yes -W %h:%p uio

Host uio
    Hostname login.math.uio.no
    user kholme
    AddressFamily inet

Host atalanta
    Hostname atalanta
    ProxyJump uio
    user kholme
    SendEnv TERM
    SetEnv TERM=xterm-256color

Host nam-shub*
    Hostname %h
    ProxyJump uio
    user kholme
    SendEnv TERM
    SetEnv TERM=xterm-256color

Host abacus*
    Hostname %h
    ProxyJump uio
    user kholme
    SendEnv TERM
    SetEnv TERM=xterm-256color

Host freebio* bioint0* ml*
    HostName %h.hpc.uio.no
    User kholme
    ForwardAgent yes
    ProxyJump uio
    SendEnv TERM
    SetEnv TERM=xterm-256color

# Multiplex through the 2FA jump host: one interactive login, reuse for dst/theme-sync/rsync.
# dst starts a dedicated `ssh -fN` master. Cursor Remote-SSH must not own this
# socket (it recycles its tunnel and would drop multiplexed tmux with it).
Host uio atalanta nam-shub* abacus* freebio* bioint0* ml*
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 4h

Host fox
    Hostname fox.educloud.no
    User ec-kholme
    setEnv TERM=xterm-256color
    ControlMaster auto
    ControlPath ~/.ssh/controlsock-%h-%p
