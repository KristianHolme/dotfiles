Host *
    # A connection that gets no answer for 5 minutes ends. A dead master
    # (wifi drop, router restart) then exits instead of hanging for a day.
    ServerAliveInterval 60
    ServerAliveCountMax 5
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host saga betzy olivia
    User kholme
    Hostname %h.sigma2.no
    setEnv TERM=xterm-256color
    # IPv6 to olivia.sigma2.no stalls from the UiO hosts; IPv4 connects at once.
    AddressFamily inet
    ControlMaster auto
    ControlPath ~/.ssh/%r@%h:%p
    ControlPersist 4h

Host uio
    Hostname login.math.uio.no
    user kholme
    AddressFamily inet

Host zadkiel
    Hostname zadkiel
    ProxyJump uio
    user kholme
    SendEnv TERM
    SetEnv TERM=xterm-256color

Host nam-shub*
    Hostname %h
    ProxyJump uio
    user kholme
    SendEnv TERM
    SetEnv TERM=xterm-256color

Host abacus*
    Hostname %h
    ProxyJump uio
    user kholme
    SendEnv TERM
    SetEnv TERM=xterm-256color

Host freebio* bioint0* ml*
    HostName %h.hpc.uio.no
    User kholme
    ProxyJump uio
    SendEnv TERM
    SetEnv TERM=xterm-256color

# Multiplex through the 2FA jump host: one interactive login, reuse for dst/theme-sync/rsync
# and Fain's ssh://zadkiel (Fain asks for the 2FA code in its command palette).
# dst starts a dedicated `ssh -fN` master. Cursor Remote-SSH must not own this
# socket (it recycles its tunnel and would drop multiplexed tmux with it).
Host uio zadkiel nam-shub* abacus* freebio* bioint0* ml*
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 4h

# Educloud Fox (2FA). Not a hub host; dotfiles-ssh-login.sh opens its master (hosts.toml ssh_masters).
Host fox
    Hostname fox.educloud.no
    User ec-kholme
    setEnv TERM=xterm-256color
    ControlMaster auto
    ControlPath ~/.ssh/%r@%h:%p
    ControlPersist 4h
