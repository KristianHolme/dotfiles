# Olivia JULIA_CPU_TARGET (single place for login shells and job wrappers).
# Login / CPU nodes: x86_64 Zen 4 (login) and Zen 5 (compute). Julia keeps the
# rightmost target the CPU supports, so znver5 stays last.
# Accel / GH200 nodes: aarch64 Grace (neoverse-v2). Do not export znver* there —
# ARM LLVM does not know those names and floods the log with ignore warnings.
case "$(uname -m)" in
x86_64)
    export JULIA_CPU_TARGET="generic;znver4,clone_all;znver5,clone_all"
    ;;
aarch64)
    export JULIA_CPU_TARGET="generic;neoverse-v2,clone_all"
    ;;
esac

interactive() {
    salloc --account=nn9886k --partition=small --ntasks=1 --cpus-per-task=32 --mem=16G --time=01:00:00 "$@"
}

interactive_gpu() {
    salloc --account=nn9886k --partition=accel --gpus=1 --ntasks=1 --cpus-per-task=16 --mem=16G --time=01:00:00 "$@"
}
