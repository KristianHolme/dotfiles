# User-local tools (must run before interactive-only return below).
export PATH="$HOME/.local/bin:$HOME/dotfiles/bin:$PATH"
# Host-specific prefix (hosts.toml install_root) prepended when replica setup wrote it.
[[ -f "$HOME/.dotfiles-install-env" ]] && . "$HOME/.dotfiles-install-env"

# If not running interactively, don't do anything (leave this near the top of this file)
[[ $- != *i* ]] && return

# Omarchy bash rc when present (desktop). Replicas skip this silently.
_omarchy_rc="$HOME/.local/share/omarchy/default/bash/rc"
if [[ -f "$_omarchy_rc" ]]; then
    # shellcheck source=/dev/null
    source "$_omarchy_rc"
fi
unset _omarchy_rc

# gum colors from Omarchy theme (bin/lib-gum.sh)
_lib_gum="$HOME/dotfiles/bin/lib-gum.sh"
if [[ -f "$_lib_gum" ]]; then
    # shellcheck source=/dev/null
    source "$_lib_gum"
    omarchy_gum_env_load
fi
unset _lib_gum

# Source custom functions
[[ -f "$HOME/dotfiles/default/dot-bashrc-functions" ]] && source "$HOME/dotfiles/default/dot-bashrc-functions"



# Aliases
alias j='julia'
alias jp='julia --project'
alias jtest='julia --project -e "using Pkg;Pkg.test()"'
alias jtemp='julia --project=@temp'
alias jn='julia +nightly'
alias jnp='julia +nightly --project'
alias lg='lazygit'
unalias r
alias r='source ~/.bashrc'
unalias cd  #omarchy aliases to zoxide
unalias ls
unalias lsa
alias l='eza -lh --group-directories-first --icons=auto'
alias la='l -a'
alias f='y'
alias ghd='gh dash'
alias tvn='nvim "$(tv)"'
alias dotfiles-help='bat ~/dotfiles/README.md'

export PATH="$HOME/.julia/bin:$PATH"

if [[ "$USER" == "kristian" ]]; then
    # Add dotfiles scripts to PATH
    alias ca='cursor-agent'
    alias dac='$HOME/dotfiles/bin/dotfiles-apply-config.sh'
    alias dsp='$HOME/dotfiles/bin/dotfiles-setup-packages.sh'
    alias drs='$HOME/dotfiles/bin/dotfiles-rsync-ssh.sh'
    alias dst='$HOME/dotfiles/bin/dotfiles-ssh-tmux.sh'
    alias tb='tensorboard --logdir'
    alias viewclaw='virt-viewer -c qemu+ssh://kristian@bengal/system claw'
else
    alias dsr='dotfiles-setup-replica.sh'
    alias dar='dotfiles-apply-replica.sh'
fi

#Operations

#variables
export JULIA_NUM_THREADS=auto


# SSH agent: use a persistent socket when present. Do not start a new agent
# per shell — that leaks processes when SSH_AUTH_SOCK is unset (replicas, SSH).
if [[ -z "${SSH_AUTH_SOCK:-}" && -n "${XDG_RUNTIME_DIR:-}" && -S "$XDG_RUNTIME_DIR/ssh-agent.socket" ]]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi

# Auto-add SSH key if agent is running and key isn't already loaded
if [[ -n "$SSH_AUTH_SOCK" ]] && command -v ssh-add &>/dev/null; then
    KEY_FILE="$HOME/.ssh/id_ed25519"
    if [[ -f "$KEY_FILE" ]]; then
        # Check if key is already loaded (suppress errors if agent connection fails)
        if ! ssh-add -l &>/dev/null || ! ssh-add -l | grep -q "$(ssh-keygen -lf "$KEY_FILE" 2>/dev/null | awk '{print $2}')" 2>/dev/null; then
            ssh-add "$KEY_FILE" 2>/dev/null
        fi
    fi
fi


# starship prompt (skip if Omarchy rc already initialized it)
if [[ -z "${STARSHIP_SESSION_KEY:-}" && "${TERM:-}" != "dumb" ]] && command -v starship &>/dev/null; then
    eval "$(starship init bash)"
fi

[[ -f "${CARGO_HOME:-$HOME/.cargo}/env" ]] && . "${CARGO_HOME:-$HOME/.cargo}/env"
[[ -f ~/.config/uwsm/default ]] && source ~/.config/uwsm/default

if command -v tv &>/dev/null; then
    eval "$(tv init bash)"
fi


# >>> juliaup initialize >>>

# !! Contents within this block are managed by juliaup !!

case ":$PATH:" in
    *:/home/kristian/.juliaup/bin:*)
        ;;

    *)
        export PATH=/home/kristian/.juliaup/bin${PATH:+:${PATH}}
        ;;
esac
# Tab completion for juliaup and julia channel selection
[ -f "/home/kristian/.julia/juliaup/completions/bash.sh" ] && source "/home/kristian/.julia/juliaup/completions/bash.sh"

# <<< juliaup initialize <<<

# zoxide - must be initialized last (skip if Omarchy rc already initialized it)
if ! declare -F __zoxide_z >/dev/null 2>&1 && command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
fi
