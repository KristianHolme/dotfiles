#!/usr/bin/env bash

# SSH_ASKPASS that asks in the Rex app's command palette (Fain or Rex.app),
# through rex.ui.input / rex.ui.pick on this machine's Rex server. Prints the
# answer for ssh; exits 1 when the question is cancelled or no app shows it.
#
#   SSH_ASKPASS=dotfiles-rex-askpass SSH_ASKPASS_REQUIRE=force ssh -fN saga </dev/null
#
# DOTFILES_ASKPASS_HOST names the host in the question's title. Fain hides
# what is typed when the question mentions a password, passphrase, PIN or code.

set -Euo pipefail

# Stop immediately if an earlier prompt in this login run was cancelled.
if [[ -n ${DOTFILES_ASKPASS_CANCEL_FILE:-} && -e $DOTFILES_ASKPASS_CANCEL_FILE ]]; then
	exit 1
fi

prompt="${1:-}"
host="${DOTFILES_ASKPASS_HOST:-}"
mode="${SSH_ASKPASS_PROMPT:-}"

rex_bin="$(command -v rex || true)"
[[ -n $rex_bin ]] || rex_bin="${HOME}/.local/bin/rex"
[[ -x $rex_bin ]] || {
	echo "dotfiles-rex-askpass: rex not found" >&2
	exit 1
}

args="$(jq -n --arg prompt "$prompt" --arg host "$host" --arg mode "$mode" \
	'{prompt: $prompt, host: $host, mode: $mode}')"

# The ssh_askpass action in init.lua prints JSON: {"text": ...} or {} on cancel.
if ! out="$(env -u REX_BLOCK "$rex_bin" do --json --args "$args" ssh_askpass 2>/dev/null)" \
	|| ! jq -e 'has("text")' >/dev/null <<<"$out"; then
	[[ -n ${DOTFILES_ASKPASS_CANCEL_FILE:-} ]] && : >"$DOTFILES_ASKPASS_CANCEL_FILE"
	exit 1
fi
text="$(jq -r '.text' <<<"$out")"
[[ -z $text && ($mode == confirm || $mode == none) ]] && exit 0
printf '%s\n' "$text"
